/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Media never changes without changing name, so it can be cached hard.
/assets/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/assets/og.png
  Cache-Control: public, max-age=31536000, immutable

# Stylesheets and scripts are edited in place under stable names, so they must
# revalidate. They were previously served immutable for a year, which meant an
# edit was invisible to anyone who had already loaded the site. Revalidation is
# a 304 against the ETag when nothing has changed, so this costs a round trip
# and no bandwidth.
/assets/style.css
  Cache-Control: public, max-age=0, must-revalidate

/assets/start.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/app.js
  Cache-Control: public, max-age=0, must-revalidate
